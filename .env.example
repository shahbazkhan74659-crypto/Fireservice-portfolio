# Copy to .env and fill in real values. Never commit the real .env (it's
# gitignored). See render.yaml for which of these are set automatically vs.
# need entering by hand in the Render dashboard on first deploy.

# --- Core Django ---
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (django-environ URL form) ---
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# --- Production only: bootstraps the Admin Hub's one shared login account
# (see core/management/commands/ensure_admin.py) — needed because Render's
# free plan has no Shell/SSH access to run `createsuperuser` by hand. Safe
# to leave set permanently: it's a no-op once the account already exists. ---
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# --- Production only: must match the deployed domain(s), comma-separated,
# each with an explicit scheme, e.g. https://iconic-techno-service.onrender.com ---
CSRF_TRUSTED_ORIGINS=

# --- Email (SendGrid, via django-anymail) — used by the Admin Hub's
# Forgot Password and Change Email OTP flows. Get the API key from
# SendGrid > Settings > API Keys (needs "Mail Send" permission). The
# DEFAULT_FROM_EMAIL address must be verified in SendGrid first (Single
# Sender Verification or full domain authentication) or sends are rejected.
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=iconictechnoservice.in@gmail.com

# --- Media storage (Cloudinary) — production only. Local dev keeps using
# the filesystem (media/), no Cloudinary account needed to develop.
# Find these on the Cloudinary dashboard home page.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
