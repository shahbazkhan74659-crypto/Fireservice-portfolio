# Copy to .env on the Oracle VM (deploy/oracle/provision.sh does this for
# you and stops so you can fill in real values). Never commit the real
# .env (it's gitignored). See CLAUDE.md's Oracle migration section and
# deploy/oracle/README.md for the full provisioning flow.

# --- Core Django ---
SECRET_KEY=
DEBUG=False
DJANGO_SETTINGS_MODULE=fireservice.settings.oracle
ALLOWED_HOSTS=

# --- Database (local Postgres, created by provision.sh — not Neon) ---
DATABASE_URL=postgres://fireservice_app:CHANGE_ME@127.0.0.1:5432/fireservice

# --- Bootstraps the Admin Hub's one shared login account (see
# core/management/commands/ensure_admin.py) — safe to leave set
# permanently, it's a no-op once the account already exists. ---
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# --- Must match how this deployment is actually reached, comma-separated,
# each with an explicit scheme, e.g. http://<reserved-public-ip> for now;
# add the custom domain (https://...) once it's bought and certbot is set
# up (see CLAUDE.md). ---
CSRF_TRUSTED_ORIGINS=

# --- Set to True only after certbot/nginx TLS is actually working —
# flipping it before that makes the site completely unreachable. ---
SECURE_SSL_REDIRECT=False

# --- Email (SendGrid, via django-anymail) — used by the Admin Hub's
# Forgot Password and Change Email OTP flows. Same key already used on
# Render can be reused here. ---
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=iconictechnoservice.in@gmail.com

# Deliberately no CLOUDINARY_* here — media is stored on this VM's local
# disk (see fireservice/settings/oracle.py), which persists across
# restarts/deploys, unlike Render's ephemeral web-service disk.
