[Unit]
Description=gunicorn daemon for Iconic Techno Service (Oracle VM)
After=network.target postgresql.service

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/FireService
Environment=DJANGO_SETTINGS_MODULE=fireservice.settings.oracle
ExecStart=/home/ubuntu/FireService/venv/bin/gunicorn \
    --workers 2 \
    --umask 0007 \
    --bind unix:/run/gunicorn-its.sock \
    fireservice.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
